# Copy this file to local.env and edit the three paths.
# Use Git Bash paths. Leave Java and Maven to `sdk use` in the same window.
#
# ARCHI_HOME is the Archi 5.3.0 application you already downloaded.
# It is the folder that contains Archi.exe.
#
# ARCHI_SRC is the Archi source tree at tag release_5.3.0.
# JARCHI_SRC is the archi-scripting-plugin tree at tag v1.7.0.

export ARCHI_HOME="/c/Users/you/Archi"
export ARCHI_SRC="/c/Users/you/src/archi"
export JARCHI_SRC="/c/Users/you/src/archi-scripting-plugin"
