/*
 * Read a JSON model and create the ArchiMate elements, relationships, and views
 * in the model that ACLI loaded before this script (see --createEmptyModel).
 *
 * Pass the JSON path on the Archi command line:
 *   --json /absolute/path/claims.json
 *
 * Element types use Archi's kebab-case names (business-actor, grouping,
 * assignment-relationship). Viewpoint ids are Archi's own
 * (layered, application_usage, technology), from
 * com.archimatetool.model/model/viewpoints.xml.
 *
 * A view node may set "parent" to another element id already placed on that
 * view. The child is then added inside that diagram object, and x/y are
 * relative to the parent. That is how a Grouping holds its members.
 * Archi stores every junction as one element. "or-junction" and
 * "and-junction" are created as a junction, then the junction type is set.
 * A relationship may set "draw": false to stay in the model without a line
 * on the views. Grouping aggregations use that so the box itself shows
 * membership.
 *
 * A view may set "routes". Each route names a relationship id and a list of
 * bendpoints in view coordinates. The line leaves the source, passes through
 * those points, and enters the target. That is how a long line travels in the
 * empty band between rows instead of through another element. jArchi stores
 * each point as an offset from the source centre and from the target centre.
 */

var Files = Java.type("java.nio.file.Files");
var Paths = Java.type("java.nio.file.Paths");
var JString = Java.type("java.lang.String");
var Integer = Java.type("java.lang.Integer");
var HashMap = Java.type("java.util.HashMap");
var System = Java.type("java.lang.System");

// Archi 5 names the technology folder "Technology & Physical". The JSON
// keeps the shorter layer name used by the rest of the example.
var TOP_FOLDERS = {
    "Business": "Business",
    "Application": "Application",
    "Technology": "Technology & Physical",
    "Strategy": "Strategy",
    "Motivation": "Motivation",
    "Implementation & Migration": "Implementation & Migration",
    "Physical": "Technology & Physical",
    "Other": "Other",
    "Views": "Views"
};

function fail(message) {
    // jArchi catches a script exception and ACLI then saves whatever was
    // built. Leaving the process here keeps a failed run from writing a file.
    System.err.println(message);
    System.exit(1);
}

var NODE_WIDTH = 148;
var NODE_HEIGHT = 58;

function argumentValue(flag) {
    var args = $.process.argv;
    var prefix = flag + "=";
    for (var i = 0; i < args.length; i++) {
        var arg = String(args[i]);
        if (arg === flag && i + 1 < args.length) {
            return String(args[i + 1]);
        }
        if (arg.indexOf(prefix) === 0) {
            return arg.substring(prefix.length);
        }
    }
    return null;
}

function readJson(path) {
    var bytes = Files.readAllBytes(Paths.get(path));
    return JSON.parse(new JString(bytes, "UTF-8"));
}

function topFolder(name) {
    var folderName = TOP_FOLDERS[name] || name;
    var match = null;
    $("folder").each(function(folder) {
        if (folder.name === folderName) {
            match = folder;
        }
    });
    if (match === null) {
        fail("Archi folder not found: " + folderName);
    }
    return match;
}

function childFolder(parent, name) {
    var match = null;
    // $(parent) is the public collection API. FolderProxy.children() is not
    // exposed to the script engine.
    $(parent).children("folder").each(function(child) {
        if (child.name === name) {
            match = child;
        }
    });
    if (match === null) {
        match = parent.createFolder(name);
    }
    return match;
}

function folderFor(layer, subfolder) {
    var parent = topFolder(layer);
    if (!subfolder) {
        return parent;
    }
    return childFolder(parent, subfolder);
}

function elementType(specType) {
    // Archi's model has one Junction class. Or and And are a property of it.
    if (specType === "or-junction" || specType === "and-junction") {
        return "junction";
    }
    return specType;
}

function junctionKind(specType) {
    if (specType === "or-junction") {
        return "or";
    }
    if (specType === "and-junction") {
        return "and";
    }
    return null;
}

function requireElement(index, id) {
    if (!index[id]) {
        fail("JSON refers to unknown element id '" + id + "'");
    }
    return index[id];
}

function absoluteCenter(diagramObject) {
    // Nested objects store x and y relative to their parent. Bendpoints are
    // offsets from each end's centre on the view, so walk up to the view.
    var x = diagramObject.bounds.x;
    var y = diagramObject.bounds.y;
    var parent = diagramObject.parent;
    while (parent && parent.type !== "archimate-diagram-model") {
        x += parent.bounds.x;
        y += parent.bounds.y;
        parent = parent.parent;
    }
    return {
        x: x + diagramObject.bounds.width / 2,
        y: y + diagramObject.bounds.height / 2
    };
}

function relativeBendpoint(absX, absY, sourceNode, targetNode) {
    var source = absoluteCenter(sourceNode);
    var target = absoluteCenter(targetNode);
    var point = new HashMap();
    point.put("startX", Integer.valueOf(Math.round(absX - source.x)));
    point.put("startY", Integer.valueOf(Math.round(absY - source.y)));
    point.put("endX", Integer.valueOf(Math.round(absX - target.x)));
    point.put("endY", Integer.valueOf(Math.round(absY - target.y)));
    return point;
}

var jsonPath = argumentValue("--json");
if (!jsonPath) {
    fail("Missing --json <file>. Example: --json /path/to/claims.json");
}

var data;
try {
    data = readJson(jsonPath);
} catch (error) {
    fail("Could not read JSON '" + jsonPath + "': " + error);
}
console.log("Reading " + jsonPath);

model.name = data.name || "Generated model";
if (data.purpose) {
    model.purpose = data.purpose;
}

var elements = {};
var elementList = data.elements || [];
for (var i = 0; i < elementList.length; i++) {
    var spec = elementList[i];
    var folder = folderFor(spec.layer, spec.folder);
    var element;
    try {
        element = model.createElement(elementType(spec.type), spec.name, folder);
    } catch (error) {
        fail("Could not create " + spec.type + " '" + spec.name + "': " + error);
    }
    var kind = junctionKind(spec.type);
    if (kind) {
        element.setJunctionType(kind);
    }
    if (spec.documentation) {
        element.documentation = spec.documentation;
    }
    element.prop("json-id", spec.id);
    elements[spec.id] = element;
}

var relationships = {};
var relationshipList = data.relationships || [];
for (var r = 0; r < relationshipList.length; r++) {
    var link = relationshipList[r];
    var source = requireElement(elements, link.source);
    var target = requireElement(elements, link.target);
    var relationship;
    try {
        relationship = model.createRelationship(link.type, link.name || "", source, target);
    } catch (error) {
        fail("Could not create " + link.type + " from '" + link.source + "' to '" + link.target + "': " + error);
    }
    relationship.prop("json-id", link.id);
    relationships[link.id] = relationship;
}

var viewList = data.views || [];
for (var v = 0; v < viewList.length; v++) {
    var viewSpec = viewList[v];
    var viewFolder = childFolder(topFolder("Views"), viewSpec.folder || "Generated");
    var view = model.createArchimateView(viewSpec.name, viewFolder);
    if (viewSpec.documentation) {
        view.documentation = viewSpec.documentation;
    }

    var nodes = {};
    var nodeList = viewSpec.nodes || [];
    for (var n = 0; n < nodeList.length; n++) {
        var nodeSpec = nodeList[n];
        var concept = requireElement(elements, nodeSpec.element);
        var container = view;
        if (nodeSpec.parent) {
            container = nodes[nodeSpec.parent];
            if (!container) {
                fail(
                    "Node '" + nodeSpec.element + "' on view '" + viewSpec.name +
                    "' is nested in '" + nodeSpec.parent +
                    "', which must appear earlier in that view"
                );
            }
        }
        try {
            nodes[nodeSpec.element] = container.add(
                concept,
                nodeSpec.x || 0,
                nodeSpec.y || 0,
                nodeSpec.w || NODE_WIDTH,
                nodeSpec.h || NODE_HEIGHT
            );
        } catch (error) {
            fail("Could not place '" + nodeSpec.element + "' on view '" + viewSpec.name + "': " + error);
        }
    }

    var connections = {};
    for (var c = 0; c < relationshipList.length; c++) {
        var relSpec = relationshipList[c];
        if (relSpec.draw === false) {
            continue;
        }
        if (nodes[relSpec.source] && nodes[relSpec.target]) {
            try {
                connections[relSpec.id] = view.add(
                    relationships[relSpec.id],
                    nodes[relSpec.source],
                    nodes[relSpec.target]
                );
            } catch (error) {
                fail("Could not draw '" + relSpec.id + "' on view '" + viewSpec.name + "': " + error);
            }
        }
    }

    var routes = viewSpec.routes || [];
    for (var routeIndex = 0; routeIndex < routes.length; routeIndex++) {
        var route = routes[routeIndex];
        var connection = connections[route.relationship];
        if (!connection) {
            fail(
                "View '" + viewSpec.name + "' routes '" + route.relationship +
                "', which is not drawn on that view"
            );
        }
        var points = route.points || [];
        for (var pointIndex = 0; pointIndex < points.length; pointIndex++) {
            var point = points[pointIndex];
            try {
                connection.addRelativeBendpoint(
                    relativeBendpoint(point.x, point.y, connection.source, connection.target),
                    pointIndex
                );
            } catch (error) {
                fail(
                    "Could not route '" + route.relationship + "' on view '" + viewSpec.name +
                    "': " + error
                );
            }
        }
    }

    if (viewSpec.viewpoint) {
        try {
            view.setViewpoint(viewSpec.viewpoint);
        } catch (error) {
            fail("Could not set viewpoint '" + viewSpec.viewpoint + "' on '" + viewSpec.name + "': " + error);
        }
    }
    console.log("View '" + view.name + "' has " + nodeList.length + " nodes");
}

console.log(
    "Created " + elementList.length + " elements, " +
    relationshipList.length + " relationships, " +
    viewList.length + " views"
);
